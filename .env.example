# Copy to .env (git-ignored) and fill in. Never commit .env.
# Read the Splunk licence terms first, then set:
SPLUNK_START_ARGS=
# Newer Splunk images also ask for the general terms flag; leave empty for 9.3.x:
SPLUNK_GENERAL_TERMS=
SPLUNK_PASSWORD=change-me-min-8-chars
SPLUNK_HEC_TOKEN=00000000-0000-0000-0000-000000000000
